# GEMINI_API_KEY: Required for Gemini AI API calls.
# You can provide a single key, comma-separated keys (e.g. key1,key2),
# or separate numbered keys like GEMINI_API_KEY_1, GEMINI_API_KEY_2 for automatic load balancing & 429 failover.
GEMINI_API_KEY="MY_GEMINI_API_KEY_1"
GEMINI_API_KEY_2="MY_GEMINI_API_KEY_2"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE ANALYTICS 4 (GA4): Measurement ID
# Create a GA4 property at analytics.google.com -> Admin -> Data Streams -> Web -> Copy Measurement ID (starts with G-)
VITE_GA_MEASUREMENT_ID="G-2ESSBNEX33"

# GOOGLE SHEETS AUTOMATION (Optional but recommended):
# Auto-save all contact form inquiries directly into a Google Sheet using Google Apps Script Web App
# GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/AKfycb.../exec"

