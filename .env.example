# ==============================================================================
# The Prescription - Environment Configuration Reference
# ==============================================================================
# Copy this file to .env or set these environment variables in your deployment
# platform (e.g., Render, Railway, Vercel, Docker).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIMARY AI ENGINE: GOOGLE GEMINI (Required)
# ------------------------------------------------------------------------------
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
#
# Multi-Key Rotation & 429 Failover:
# You can supply a single key, comma-separated keys in GEMINI_API_KEY, or
# sequential variables (GEMINI_API_KEY_1, GEMINI_API_KEY_2, GEMINI_API_KEY_3...).
# The server automatically pools and round-robins them, seamlessly backing off on rate limits.
GEMINI_API_KEY="AIzaSyYourPrimaryGeminiApiKeyHere"
GEMINI_API_KEY_2="AIzaSyYourSecondaryGeminiApiKeyHere"
# GEMINI_API_KEY_3=""

# ------------------------------------------------------------------------------
# 2. SECONDARY / FALLBACK MULTIMODAL ENGINES (Optional)
# ------------------------------------------------------------------------------
# If all Gemini keys exhaust quota or experience outages, the vision pipeline
# cascades automatically to backup vision models.
#
# Groq (Llama 3.2 90B / 11B Vision) - https://console.groq.com/
GROQ_API_KEY="gsk_YourGroqApiKeyHere"

# xAI Grok Vision - https://console.x.ai/
# XAI_API_KEY="xai-YourXAIApiKeyHere"

# ------------------------------------------------------------------------------
# 3. SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Port for the Node.js Express server (Render/Cloud hosts automatically set PORT)
PORT=3000
NODE_ENV="production"

# Public production URL where the application is hosted
APP_URL="https://www.theprescription.in"

# ------------------------------------------------------------------------------
# 4. CLIENT TELEMETRY & ANALYTICS
# ------------------------------------------------------------------------------
# Google Analytics 4 (GA4) Measurement ID (starts with G-)
# Used in client-side Vite builds
VITE_GA_MEASUREMENT_ID="G-2ESSBNEX33"

# ------------------------------------------------------------------------------
# 5. CONTACT & FEEDBACK FORM NOTIFICATIONS (Optional)
# ------------------------------------------------------------------------------
# The server features a multi-provider fallback waterfall for sending contact
# form submissions and administrative alerts:
# Brevo (Sendinblue) -> SendGrid -> Resend -> Gmail/Custom SMTP
#
# Preferred provider override: "brevo" | "sendgrid" | "resend" | "smtp"
# EMAIL_PROVIDER="brevo"
#
# Brevo (Recommended for free tier transactional emails):
# BREVO_API_KEY="xkeysib-..."
# BREVO_FROM="theprescriptionn@gmail.com"
#
# SendGrid:
# SENDGRID_API_KEY="SG...."
# SENDGRID_FROM="theprescriptionn@gmail.com"
#
# Resend:
# RESEND_API_KEY="re_..."
# RESEND_FROM="onboarding@resend.dev"
#
# Gmail / Custom SMTP fallback:
EMAIL_USER="Theprescriptionn@gmail.com"
# EMAIL_APP_PASSWORD="your-16-char-google-app-password"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587

# ------------------------------------------------------------------------------
# 6. GOOGLE SHEETS FORM LOGGING (Optional)
# ------------------------------------------------------------------------------
# Webhook URL (Google Apps Script web app) to automatically log patient feedback
# or contact queries directly into a Google Sheet.
# GOOGLE_SHEET_WEBHOOK_URL="https://script.google.com/macros/s/..."
