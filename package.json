{
  "name": "the-prescription",
  "private": true,
  "version": "1.0.0",
  "description": "AI-powered clinical prescription decoder, medicine interaction analyzer, and personalized patient dosage scheduler.",
  "type": "module",
  "homepage": "https://www.theprescription.in",
  "repository": {
    "type": "git",
    "url": "https://github.com/ikingarmaan/The-Prescriptions.git"
  },
  "bugs": {
    "url": "https://github.com/ikingarmaan/The-Prescriptions/issues"
  },
  "author": "Armaan <https://github.com/ikingarmaan>",
  "license": "MIT",
  "keywords": [
    "prescription-analyzer",
    "medical-ai",
    "gemini-vision",
    "clinical-ocr",
    "drug-interactions",
    "dosage-scheduler",
    "healthcare",
    "react-19",
    "typescript",
    "tailwind-css"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc --noEmit && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.546.0",
    "nodemailer": "^10.0.9",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
